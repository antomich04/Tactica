{
 "$defs": {
  "CardColor": {
   "enum": [
    "yellow",
    "red"
   ],
   "title": "CardColor",
   "type": "string"
  },
  "CardEvent": {
   "properties": {
    "id": {
     "description": "Unique event identifier, e.g., e_1201",
     "title": "Id",
     "type": "string"
    },
    "match_id": {
     "description": "Unique match identifier, e.g., m_001",
     "title": "Match Id",
     "type": "string"
    },
    "timestamp": {
     "description": "Match time in seconds from kickoff",
     "minimum": 0.0,
     "title": "Timestamp",
     "type": "number"
    },
    "team": {
     "description": "Team identifier or club name",
     "title": "Team",
     "type": "string"
    },
    "player": {
     "description": "Player name or identifier",
     "title": "Player",
     "type": "string"
    },
    "x": {
     "description": "Pitch X coordinate (0-100)",
     "maximum": 100.0,
     "minimum": 0.0,
     "title": "X",
     "type": "number"
    },
    "y": {
     "description": "Pitch Y coordinate (0-100)",
     "maximum": 100.0,
     "minimum": 0.0,
     "title": "Y",
     "type": "number"
    },
    "type": {
     "const": "card",
     "default": "card",
     "title": "Type",
     "type": "string"
    },
    "card_color": {
     "$ref": "#/$defs/CardColor"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    }
   },
   "required": [
    "id",
    "match_id",
    "timestamp",
    "team",
    "player",
    "x",
    "y",
    "card_color"
   ],
   "title": "CardEvent",
   "type": "object"
  },
